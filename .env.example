####################################################################################
# LEXX 2.0 — environment configuration
#
#   cp .env.example .env   then fill the SECRETS block
#   or just run:  node scripts/bootstrap-env.js   (generates .env with CSPRNG secrets)
#
# Never commit a real .env. Never put real secrets in this file.
####################################################################################

NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- core API ----
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
# Origin of the web client. The QR on every s.63 certificate points here, so it must
# be reachable from whatever scans it — a phone cannot resolve "localhost".
PUBLIC_WEB_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- database ----
# Point this at any MongoDB. If you have none installed, run `npm run mongo:dev`
# in a separate terminal — it starts a real mongod on this port with persistent data.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_CORE=lexx_core
MONGO_SERVER_SELECTION_MS=5000

# ------------------------------------------------- authority directories ----
# Read-only to Lexx. Lexx can NEVER write to these.
DIRECTORY_POLICE_URL=http://localhost:6001
DIRECTORY_COURT_URL=http://localhost:6002
DIRECTORY_LEGAL_URL=http://localhost:6003
DIRECTORY_TIMEOUT_MS=2000
DIRECTORY_RETRIES=1

####################################################################################
# SECRETS — no defaults exist for these. The API refuses to start without them.
# Generate with:  node scripts/bootstrap-env.js
####################################################################################

# >= 32 chars each
JWT_SECRET=
REFRESH_SECRET=
QR_SECRET=

# Exactly 64 hex characters (32 bytes). Wraps every per-case KEK.
# In production this belongs in a KMS/HSM, not an env var (see docs/SECURITY.md).
MASTER_KEK=

# ---------------------------------------------------------------- lifetimes ----
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=43200
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
TRANSFER_TOKEN_TTL_SEC=300
STREAM_TOKEN_TTL_SEC=60

# ------------------------------------------------- rate limits (per IP / 15 min) ----
# Loopback requests are exempt while NODE_ENV is not production, so `npm run seed`
# can provision nine accounts without tripping these. That exemption is hard-refused
# in production, where every request arrives from loopback via the reverse proxy.
RATE_LIMIT_OTP=10
RATE_LIMIT_LOGIN=20
RATE_LIMIT_LOOKUP=60

# ---------------------------------------------------------------- storage ----
STORAGE_DIR=./vault
MAX_UPLOAD_BYTES=268435456

####################################################################################
# BLOCKCHAIN — MONAD TESTNET
#
# Only Merkle roots and batch metadata go on-chain.
# No evidence, no file contents, no PII, no AI triage scores. Ever.
####################################################################################

# Submit anchor transactions to the chain. Needs a funded ANCHOR_PRIVATE_KEY.
ANCHOR_ENABLED=false
# Run the periodic batcher at all. Batching computes and stores the Merkle root and
# is useful without a chain; ANCHOR_ENABLED only decides whether it is also submitted.
# With this off, `GET /api/anchors/latest` will always say nothing has been anchored.
ANCHOR_BATCHING_ENABLED=true
ANCHOR_NETWORK=monad-testnet
ANCHOR_CHAIN_ID=10143
ANCHOR_RPC_URL=https://testnet-rpc.monad.xyz
ANCHOR_EXPLORER_BASE=https://testnet.monadexplorer.com

# Set after `npm run contracts:deploy`
ANCHOR_CONTRACT_ADDRESS=

# Anchor signer. Leave EMPTY to run the batcher in dry-run (Merkle roots computed and
# stored, nothing submitted). Use a throwaway testnet key funded with Monad Testnet
# MON. NEVER a mainnet key. NEVER commit this.
ANCHOR_PRIVATE_KEY=

ANCHOR_INTERVAL_MS=300000
ANCHOR_BATCH_MAX=1000
ANCHOR_CONFIRMATIONS=1

####################################################################################
# DEMO AFFORDANCES — refused when NODE_ENV=production
####################################################################################

# Returns the OTP in the API response so the demo does not need a real SMS gateway.
# This makes the OTP factor non-secret. Off by default, deliberately.
DEMO_ECHO_OTP=false
