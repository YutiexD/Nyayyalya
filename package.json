{
  "name": "lexx",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "LEXX 2.0 — AI-assisted, blockchain-backed digital evidence registry (Monad Testnet anchoring)",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "concurrently -n police,court,legal,api,web -c blue,magenta,cyan,green,yellow \"npm:dev:dir:police\" \"npm:dev:dir:court\" \"npm:dev:dir:legal\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:dir:police": "node directories/police/server.js",
    "dev:dir:court": "node directories/court/server.js",
    "dev:dir:legal": "node directories/legal/server.js",
    "dev:api": "node backend/server.js",
    "start": "npm run dev",
    "seed": "node seed/seed-all.js",
    "migrate": "node scripts/migrate.js",
    "reset": "node seed/reset.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run backend/tests/unit",
    "test:integration": "vitest run backend/tests/integration",
    "test:authz": "vitest run backend/tests/authz",
    "test:negative": "vitest run backend/tests/negative",
    "test:redteam": "vitest run backend/tests/redteam",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm --prefix frontend run build",
    "contracts:compile": "npm --prefix contracts run compile",
    "contracts:test": "npm --prefix contracts run test",
    "contracts:deploy": "npm --prefix contracts run deploy:monadTestnet",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix contracts install",
    "health": "node scripts/health-check.js",
    "verify:no-stale-sepolia": "node scripts/check-network-references.js",
    "mongo:dev": "node scripts/mongo-dev-server.js",
    "dev:web": "npm --prefix frontend run dev",
    "routes": "node scripts/dump-routes.js",
    "tamper": "node scripts/tamper-demo.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lightswind": "^3.2.5",
    "lucide-react": "^1.47.0",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
