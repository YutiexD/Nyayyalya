# ---- secrets -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# Written by `npm run seed`. Contains ECDSA PRIVATE KEYS for the demo accounts so a
# demo operator can sign from any machine. Never commit it.
seed/.demo-identities.json
**/.demo-identities.json

# ---- dependencies --------------------------------------------------------
node_modules/
.npm/

# ---- runtime data --------------------------------------------------------
# Encrypted evidence objects. Never committed.
vault/
.data/
*.log
logs/

# ---- build / test artefacts ---------------------------------------------
dist/
build/
coverage/
.vitest/
frontend/dist/
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

# ---- deployment output ---------------------------------------------------
# Contains the deployed address; regenerated by deploy. Safe to ignore.
contracts/deployments/*.local.json

# ---- editor / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
