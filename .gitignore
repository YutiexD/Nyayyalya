# ---- secrets -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.jks
*.keystore

# Wallet / private-key files (Hardhat, Foundry, etc.)
.secret
*.secret
hardhat.config.local.js
foundry.toml.local

# Written by `npm run seed`. Contains ECDSA PRIVATE KEYS for the demo accounts so a
# demo operator can sign from any machine. Never commit it.
seed/.demo-identities.json
**/.demo-identities.json

# ---- dependencies --------------------------------------------------------
node_modules/
.npm/

# ---- runtime data --------------------------------------------------------
# Encrypted evidence objects. Never committed.
vault/
.data/
*.log
logs/

# ---- build / test artefacts ---------------------------------------------
dist/
build/
coverage/
.vitest/
frontend/dist/
contracts/artifacts/
contracts/cache/
contracts/typechain-types/

# ---- deployment output ---------------------------------------------------
# Contains the deployed address; regenerated by deploy. Safe to ignore.
contracts/deployments/*.local.json

# ---- editor / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Stray local server logs from ad-hoc runs
.api.log
.api.err

# Reference copy of the pre-React client, kept during the rewrite
frontend-legacy/

# Local design / planning docs — not part of the deployable product
PRESENTATION.md
WORKFLOW.md
DESIGN.md

# Legacy TypeScript component reference (lexx V2 src/ folder)
src/

# Local MongoDB data directory if using mongo-dev-server.js
.mongo/
mongodata/

# Temporary script output and local health-check artefacts
*.health.json
*.dump.json
